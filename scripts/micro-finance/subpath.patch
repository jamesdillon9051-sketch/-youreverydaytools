+    expect(appUrl('?action=log')).toBe('/finance/?action=log');
+  });
+});
diff --git a/src/lib/appUrl.ts b/src/lib/appUrl.ts
new file mode 100644
index 0000000..0d7ca47
--- /dev/null
+++ b/src/lib/appUrl.ts
@@ -0,0 +1,8 @@
+/**
+ * A path inside the app, resolved against where it is served from: `/` when the app has its own address,
+ * or a folder such as `/finance/` when it lives inside another site (`vite build --base=/finance/`).
+ * `path` is relative to the app's root: `appUrl('sw.js')`, `appUrl('?tab=bills')`, `appUrl()` for its home.
+ */
+export function appUrl(path = ''): string {
+  return `${import.meta.env.BASE_URL}${path}`;
+}
